{
  "expo": {
    "name": "Retail POS",
    "slug": "retail-pos-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/retail-pos-splash.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1D4ED8",
        "foregroundImage": "./assets/retail-pos-splash.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/retail-pos-splash-branded.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#172554"
        }
      ],
      "expo-sharing"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
